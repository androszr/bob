# .env.example -- copy to .env (`cp .env.example .env`) and fill in the values.
#
# .env is in .gitignore and never reaches the repo -- this file holds only variable
# names and safe defaults, no secrets.
#
# A variable set in the environment (export) wins over .env: the loaders use
# os.environ.setdefault(). An empty value = use the default from the code.

# ---------------------------------------------------------------------------
# Jira / Atlassian
# ---------------------------------------------------------------------------

# Bearer token for the Jira REST API (MCP servers jira-bob / jira-read-bob).
ATLASSIAN_TOKEN=

# Jira address. Empty = https://jira.example.com (a placeholder -- nothing will work).
#JIRA_URL=https://jira.example.com
# Board with the sprints. Empty = sprint features report "not configured".
#JIRA_BOARD_ID=123
# Default project (reports, Tempo). Empty = PROJ.
#JIRA_PROJECT=PROJ
# Teams -- a team's sprint is "<Team> Sprint <N>" on the board. Empty = no teams.
#JIRA_TEAMS=Alpha,Beta
# The owner's Jira login -- default reporter of tickets from jira_create. Empty = Jira
# uses the token's owner.
#OWNER_JIRA_LOGIN=jan.kowalski@example.com
# The organisation's e-mail domain: accounts in this domain come first in user search.
#ORG_EMAIL_DOMAIN=example.com
# PATH TO A FILE with field ids and issue types (example: config/jira-fields.example.json).
# Default <repo>/config/jira-fields.json. No file = jira_create unavailable.
#JIRA_FIELDS_FILE=

# Set to "false" to turn off TLS verification (debug only).
#VERIFY_SSL=true

# ---------------------------------------------------------------------------
# md-to-mp3 -- Gemini TTS
# ---------------------------------------------------------------------------

# Gemini API key. The form "provider:key" is allowed -- the code takes the part
# after the first colon.
GOOGLE_GEMINI=

#GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# PATH ON DISK -- output folder for the MP3 files.
# Default <repo>/user-data/md-to-mp3.
#MD_TO_MP3_DIR=

# Parallel TTS requests (clamped to 1-10).
#MD_TO_MP3_TTS_CONCURRENCY=3

# Voice ids for voice='female' and voice='male'.
# The older names MD_TO_MP3_VOICE_KOBIETA_ID / MD_TO_MP3_VOICE_MEZCZYZNA_ID are still read.
#MD_TO_MP3_VOICE_FEMALE_ID=Kore
#MD_TO_MP3_VOICE_MALE_ID=Charon

# ---------------------------------------------------------------------------
# Owner and organisation (scripts/org_config.py)
# ---------------------------------------------------------------------------
# The Teams account the bot writes from (= the owner). The GUID from the MRI "8:orgid:<GUID>".
# Empty = nobody has owner rights.
#OWNER_TEAMS_USER_ID=00000000-0000-0000-0000-000000000000
# That account's display name in Teams. Empty = Owner.
#OWNER_DISPLAY_NAME=Kowalski Jan
# How the owner is labelled in the chat history shown to the model. Empty = Owner.
# Changing it splits the labels in existing history -- set it once.
#OWNER_ALIAS=Boss

# Name of the owner's notes chat in chat-config.json; owner reminders go there by default.
# An install whose notes chat is still called "Notatki" can set that name here.
#BOB_NOTES_CHAT=Notes

# Time zone for dates, schedules and the leave sheet (an IANA name). Default Europe/Warsaw.
#BOB_TIMEZONE=Europe/Warsaw

# SharePoint tenant: "contoso" -> contoso.sharepoint.com and contoso-my.sharepoint.com.
# Empty = SharePoint features (leave sheet, file upload) off.
#SHAREPOINT_TENANT=contoso
# "Share" link to the team leave spreadsheet (…/:x:/r/personal/<user>/Documents/<file>.xlsx?d=w<id>).
# Empty = leave poller off. The older name URLOPY_SHAREPOINT_URL is still read.
#LEAVE_SHAREPOINT_URL=https://contoso-my.sharepoint.com/:x:/r/personal/jan_kowalski_contoso_com/Documents/Leave.xlsx?d=w0123456789abcdef0123456789abcdef
# SharePoint folder for files sent with [SEND_FILE]. Empty = upload off.
#SHAREPOINT_UPLOAD_FOLDER_URL=https://contoso.sharepoint.com/:f:/r/sites/Team/Shared%20Documents/Bob
# PATH TO A FILE with people to @-mention (example: scripts/teams_agent/people.example.json).
# Default scripts/teams_agent/people.json. No file = empty tables.
#PEOPLE_FILE=
# Prefixes of outside companies in display names ("EXT Ewa Nowak"), skipped when
# matching people. Comma-separated. Empty = none.
#NAME_NOISE_PREFIXES=EXT

# ---------------------------------------------------------------------------
# Bob -- the Teams daemon
# ---------------------------------------------------------------------------

# Giphy key for replies with GIFs. Empty = GIFs are skipped without an error.
GIPHY_API_KEY=

# Set to "http" to start the MCP servers on streamable-http instead of stdio.
#BOB_MCP_TRANSPORT=

# Set to "1" to turn on detailed DOM/frame scraper diagnostics.
#TEAMS_ROBOT_DEBUG=

# ---------------------------------------------------------------------------
# Panel (./bob -- scripts/bob_panel)
# ---------------------------------------------------------------------------
# Panel port on 127.0.0.1. Default 3006.
#BOB_PANEL_PORT=3006
# Login shell the panel starts the agent in. Default /bin/zsh.
#BOB_PANEL_SHELL=/bin/zsh
# PATH to the roles file (example: roles.example.json). Default <repo>/roles.json.
#BOB_ROLES_FILE=

# ---------------------------------------------------------------------------
# Reports from Snowflake (scripts/snowflake_bob, docs/snowflake-reports.md)
# ---------------------------------------------------------------------------
# Without configuration the reports run on made-up demo data and say so.
# Connector: pip install -r requirements-snowflake.txt. There is no password on purpose: SSO or a key pair.
#SNOWFLAKE_BACKEND=demo
#SNOWFLAKE_ACCOUNT=
#SNOWFLAKE_USER=
# A read-only role.
#SNOWFLAKE_ROLE=
#SNOWFLAKE_WAREHOUSE=
# Default externalbrowser (SSO in the browser).
#SNOWFLAKE_AUTHENTICATOR=externalbrowser
# PATH to the private key; when set, it replaces the browser sign-in.
#SNOWFLAKE_PRIVATE_KEY_FILE=
# Database and schema with the report tables. Default DEMO.STAFFING.
#SNOWFLAKE_SCHEMA=DEMO.STAFFING
# Names in the report header. Default Acme / Workforce analytics.
#BOB_REPORT_ORG=
#BOB_REPORT_TEAM=
# The sign in front of plan costs, like $. None by default.
#BOB_REPORT_CURRENCY=
# Named people on a real report's site card (team lead, planner, director). Off, because reports get uploaded and forwarded.
#BOB_REPORT_CONTACTS=1
# Folder for the reports. Default <repo>/user-data/reports.
#BOB_REPORT_DIR=

# ---------------------------------------------------------------------------
# Notes
# ---------------------------------------------------------------------------
#
# BOB_SENDER_MRI / BOB_SENDER / BOB_CURRENT_CHAT are injected per task by the
# daemon into the environment of the MCP subprocesses (BOB_SENDER_MRI gates the
# privileged tools) -- do NOT set them here.
#
# OTEL telemetry (CLAUDE_CODE_ENABLE_TELEMETRY, OTEL_EXPORTER_OTLP_PROTOCOL,
# OTEL_EXPORTER_OTLP_ENDPOINT) is set in your own environment, if you want it.
