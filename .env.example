# .env.example -- skopiuj do .env (`cp .env.example .env`) i uzupelnij wartosci.
#
# .env jest w .gitignore i nigdy nie trafia do repo -- tutaj sa wylacznie nazwy
# zmiennych oraz bezpieczne wartosci domyslne, zadnych sekretow.
#
# Zmienna ustawiona w srodowisku (export) wygrywa z .env: loadery uzywaja
# os.environ.setdefault(). Pusta wartosc = uzyj wartosci domyslnej z kodu.

# ---------------------------------------------------------------------------
# Jira / Atlassian
# ---------------------------------------------------------------------------

# Token Bearer do REST API Jiry (serwery MCP jira-bob / jira-read-bob).
ATLASSIAN_TOKEN=

# Adres Jiry. Pusty = https://jira.example.com (placeholder -- nic nie zadziala).
#JIRA_URL=https://jira.example.com
# Board ze sprintami. Pusty = funkcje sprintowe zglaszaja "not configured".
#JIRA_BOARD_ID=123
# Projekt domyslny (raporty, Tempo). Pusty = PROJ.
#JIRA_PROJECT=PROJ
# Zespoly -- sprint zespolu to "<Zespol> Sprint <N>" na boardzie. Pusty = brak zespolow.
#JIRA_TEAMS=Alpha,Beta
# Login Jiry wlasciciela -- domyslny reporter ticketow z jira_create. Pusty = Jira
# wstawia wlasciciela tokenu.
#OWNER_JIRA_LOGIN=jan.kowalski@example.com
# Domena e-mail organizacji: konta z ta domena ida pierwsze w wyszukiwaniu userow.
#ORG_EMAIL_DOMAIN=example.com
# SCIEZKA DO PLIKU z ID pol i typow zgloszen (wzor: config/jira-fields.example.json).
# Domyslnie <repo>/config/jira-fields.json. Brak pliku = jira_create niedostepne.
#JIRA_FIELDS_FILE=

# Ustaw na "false", by wylaczyc weryfikacje TLS (tylko debug).
#VERIFY_SSL=true

# ---------------------------------------------------------------------------
# md-to-mp3 -- Gemini TTS
# ---------------------------------------------------------------------------

# Klucz API Gemini. Dopuszczalny format "provider:klucz" -- kod bierze czesc
# po pierwszym dwukropku.
GOOGLE_GEMINI=

#GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# SCIEZKA NA DYSKU -- katalog wyjsciowy na pliki MP3.
# Domyslnie <repo>/user-data/md-to-mp3.
#MD_TO_MP3_DIR=

# Rownolegle zapytania TTS (przycinane do zakresu 1-10).
#MD_TO_MP3_TTS_CONCURRENCY=3

#MD_TO_MP3_VOICE_KOBIETA_ID=Kore
#MD_TO_MP3_VOICE_MEZCZYZNA_ID=Charon

# ---------------------------------------------------------------------------
# Wlasciciel i organizacja (scripts/org_config.py)
# ---------------------------------------------------------------------------
# Konto Teams, z ktorego pisze bot (= wlasciciel). GUID z MRI "8:orgid:<GUID>".
# Pusty = nikt nie ma uprawnien wlasciciela.
#OWNER_TEAMS_USER_ID=00000000-0000-0000-0000-000000000000
# Nazwa wyswietlana tego konta w Teams. Pusty = Owner.
#OWNER_DISPLAY_NAME=Kowalski Jan
# Jak wlasciciel jest podpisywany w historii rozmow pokazywanej modelowi. Pusty = Owner.
# Zmiana rozdziela etykiety w istniejacej historii -- ustaw raz.
#OWNER_ALIAS=Szef

# Tenant SharePoint: "contoso" -> contoso.sharepoint.com i contoso-my.sharepoint.com.
# Pusty = funkcje SharePoint (urlopy, upload plikow) wylaczone.
#SHAREPOINT_TENANT=contoso
# Link "udostepnij" do arkusza urlopow (…/:x:/r/personal/<user>/Documents/<plik>.xlsx?d=w<id>).
# Pusty = poller urlopow wylaczony.
#URLOPY_SHAREPOINT_URL=https://contoso-my.sharepoint.com/:x:/r/personal/jan_kowalski_contoso_com/Documents/Urlopy.xlsx?d=w0123456789abcdef0123456789abcdef
# Folder SharePoint na pliki wysylane przez [WYSLIJ_PLIK]. Pusty = upload wylaczony.
#SHAREPOINT_UPLOAD_FOLDER_URL=https://contoso.sharepoint.com/:f:/r/sites/Team/Shared%20Documents/Bob
# SCIEZKA DO PLIKU z osobami do @-wzmianek (wzor: scripts/teams_agent/people.example.json).
# Domyslnie scripts/teams_agent/people.json. Brak pliku = puste tabele.
#PEOPLE_FILE=
# Prefiksy firm zewnetrznych w nazwach wyswietlanych ("EXT Ewa Nowak"), pomijane przy
# dopasowaniu osob. Lista po przecinku. Pusty = brak.
#NAME_NOISE_PREFIXES=EXT

# ---------------------------------------------------------------------------
# Bob -- daemon Teams
# ---------------------------------------------------------------------------

# Klucz Giphy do odpowiedzi z GIF-ami. Pusty = GIF-y sa pomijane bez bledu.
GIPHY_API_KEY=

# Ustaw "http", by serwery MCP wystartowaly na streamable-http zamiast stdio.
#BOB_MCP_TRANSPORT=

# Ustaw "1", by wlaczyc szczegolowa diagnostyke scrapera DOM/frame.
#TEAMS_ROBOT_DEBUG=

# ---------------------------------------------------------------------------
# Uwagi
# ---------------------------------------------------------------------------
#
# BOB_SENDER_MRI / BOB_SENDER / BOB_CURRENT_CHAT sa wstrzykiwane per-zadanie
# przez daemon do srodowiska podprocesow MCP (BOB_SENDER_MRI bramkuje
# uprzywilejowane narzedzia) -- NIE ustawiaj ich tutaj.
#
# Telemetria OTEL (CLAUDE_CODE_ENABLE_TELEMETRY, OTEL_EXPORTER_OTLP_PROTOCOL,
# OTEL_EXPORTER_OTLP_ENDPOINT) ustawiasz we wlasnym srodowisku, jesli jej chcesz.
