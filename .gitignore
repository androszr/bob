# Live config: copy from the *.example.* file next to it and fill in real values
chat-config.json
roles.json
scripts/broadcast/jobs.json
scripts/broadcast/worklog-teams.json
scripts/broadcast/broadcast-schedule.json
scripts/broadcast/briefs/*.md
