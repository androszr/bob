# Phase 4 org config: real people / Jira IDs (copy from the *.example.json next to each)
scripts/teams_agent/people.json
config/jira-fields.json

# Temp files written next to secrets (bearer token, cookies, chat config) during atomic writes
*.tmp
.*.tmp
*.tmp.json

# Personal daily recaps written by chat_recap.py (only the README is tracked)
knowledge/daily-recap/*.md
!knowledge/daily-recap/README.md

# Anywhere in the tree: JSONL logs/sniffs (chat content) and browser session / cookie / token files
*.jsonl
session*.json
*cookies*.json
.*token*

# Local virtualenv
.venv/

